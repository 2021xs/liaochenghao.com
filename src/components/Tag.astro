---
import { getRelativeLocaleUrl } from "astro:i18n";
import IconHash from "@/assets/icons/IconHash.svg";
import config from "@/config";

type Props = {
  tag: string;
  tagName: string;
  size?: "sm" | "lg";
  variant?: "default" | "metadata";
};

const { tag, tagName, size = "lg", variant = "default" } = Astro.props;

const locale = Astro.currentLocale ?? config.site.lang;
---

<li
  class:list={[
    {
      "after:text-muted-foreground flex items-center gap-2 after:content-['·'] last:after:content-none":
        variant === "metadata",
    },
  ]}
>
  <a
    href={getRelativeLocaleUrl(locale, `tags/${tag}/`)}
    transition:name={tag}
    class:list={[
      "flex items-center gap-0.5",
      {
        "border-foreground hover:border-accent hover:text-accent focus-visible:text-accent border-b-2 border-dashed focus-visible:border-none":
          variant === "default",
      },
      {
        "text-muted-foreground hover:text-accent focus-visible:text-accent font-normal no-underline":
          variant === "metadata",
      },
      { "text-sm": size === "sm" },
      { "text-lg": size === "lg" },
    ]}
  >
    {
      variant === "default" && (
        <IconHash
          class:list={[
            "opacity-80",
            { "size-5": size === "lg" },
            { "size-4": size === "sm" },
          ]}
        />
      )
    }
    {tagName}
  </a>
</li>

---
import { getCollection } from "astro:content";
import type { GetStaticPathsOptions } from "astro";
import Layout from "@/layouts/Layout.astro";
import Header from "@/components/Header.astro";
import Main from "@/components/Main.astro";
import Breadcrumb from "@/components/Breadcrumb.astro";
import Card from "@/components/Card.astro";
import Footer from "@/components/Footer.astro";
import Pagination from "@/components/Pagination.astro";
import { getUniqueTags } from "@/utils/getUniqueTags";
import { getSortedPosts } from "@/utils/getSortedPosts";
import { slugifyAll } from "@/utils/slugify";
import {
  BROWSE_CATEGORIES,
  getBrowseCategories,
  getBrowseCategory,
} from "@/utils/browseTags";
import { useTranslations } from "@/i18n";
import config from "@/config";

export async function getStaticPaths({ paginate }: GetStaticPathsOptions) {
  const posts = await getCollection("posts", ({ data }) => !data.draft);
  const tagsBySlug = new Map(
    getUniqueTags(posts).map(tag => [tag.tag, tag] as const)
  );

  for (const { tag, label } of BROWSE_CATEGORIES) {
    tagsBySlug.set(tag, { tag, tagName: label });
  }

  return [...tagsBySlug.values()].flatMap(({ tag, tagName }) => {
    const browseCategory = getBrowseCategory(tag);
    const tagPosts = getSortedPosts(
      posts.filter(({ data }) =>
        browseCategory
          ? getBrowseCategories(data.tags).includes(browseCategory)
          : slugifyAll(data.tags).includes(tag)
      )
    );

    return paginate(tagPosts, {
      params: { tag },
      props: { tagName },
      pageSize: config.posts.perPage,
    });
  });
}

const { page, tagName } = Astro.props;

const locale = Astro.currentLocale ?? config.site.lang;
const t = useTranslations(locale);
---

<Layout title={`${t.pages.tagTitle}: ${tagName} | ${config.site.title}`}>
  <Header />

  <Breadcrumb />

  <Main
    pageTitle={`${t.pages.tagTitle}: ${tagName}`}
    pageDesc={page.data.length > 0
      ? `${t.pages.tagDesc} "${tagName}".`
      : `No writing in "${tagName}" yet.`}
  >
    {
      page.data.length > 0 && (
        <ul>
          {page.data.map(data => (
            <Card {...data} />
          ))}
        </ul>
      )
    }
  </Main>

  <Pagination {page} />

  <Footer noMarginTop={page.lastPage > 1} />
</Layout>

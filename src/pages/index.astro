---
import { getCollection } from "astro:content";
import { getRelativeLocaleUrl } from "astro:i18n";
import IconArrowRight from "@/assets/icons/IconArrowRight.svg";
import Layout from "@/layouts/Layout.astro";
import Header from "@/components/Header.astro";
import Footer from "@/components/Footer.astro";
import Card from "@/components/Card.astro";
import LinkButton from "@/components/LinkButton.astro";
import { BROWSE_TAGS } from "@/utils/browseTags";
import { getSortedPosts } from "@/utils/getSortedPosts";
import { useTranslations } from "@/i18n";
import config from "@/config";

const { posts: postsConfig } = config;

const locale = Astro.currentLocale ?? config.site.lang;
const t = useTranslations(locale);

const posts = await getCollection("posts");
const sortedPosts = getSortedPosts(posts);
const homePath = getRelativeLocaleUrl(locale, "");
const rssPath = `${import.meta.env.BASE_URL.replace(/\/?$/, "/")}rss.xml`;
const githubUrl = "https://github.com/2021xs/liaochenghao.com";
---

<Layout>
  <Header />
  <main
    id="main-content"
    data-layout="index"
    data-home-path={homePath}
    class="app-layout my-1"
  >
    <section id="intro" class="border-border border-b py-8 sm:py-10">
      <h1 class="text-2xl leading-tight font-semibold sm:text-3xl">
        Backend · Agent · Distributed Systems
      </h1>
      <p class="mt-4 max-w-2xl leading-relaxed">
        写技术、项目和面试复盘，也整理真正有用的工具、资源与经验。
      </p>
      <div class="mt-4 flex flex-wrap gap-x-5 gap-y-2 text-sm">
        <a
          href={githubUrl}
          target="_blank"
          rel="noopener noreferrer"
          class="hover:text-accent decoration-dashed underline-offset-4 hover:underline"
        >
          GitHub
        </a>
        <a
          href={rssPath}
          class="hover:text-accent decoration-dashed underline-offset-4 hover:underline"
        >
          RSS
        </a>
      </div>
    </section>

    <section id="browse" class="border-border border-b py-10">
      <h2 class="text-2xl font-semibold tracking-wide">Browse</h2>
      <ul class="mt-5 grid gap-x-8 gap-y-3 sm:grid-cols-2">
        {
          BROWSE_TAGS.map(({ label, tag }) => (
            <li>
              <a
                href={getRelativeLocaleUrl(locale, `tags/${tag}`)}
                data-astro-prefetch="viewport"
                class="hover:text-accent flex items-center justify-between border-b border-dashed py-2 font-medium"
              >
                <span>{label}</span>
                <IconArrowRight
                  aria-hidden="true"
                  class="size-5 rtl:-rotate-180"
                />
              </a>
            </li>
          ))
        }
      </ul>
    </section>

    {
      sortedPosts.length > 0 && (
        <section id="latest" class="pt-10 pb-6">
          <h2 class="text-2xl font-semibold tracking-wide">
            {t.home.recentPosts}
          </h2>
          <ul>
            {sortedPosts.slice(0, postsConfig.perIndex).map(data => (
              <Card variant="h3" {...data} />
            ))}
          </ul>
          <div class="mt-8 text-center">
            <LinkButton
              href={getRelativeLocaleUrl(locale, "posts")}
              data-astro-prefetch="viewport"
            >
              {t.home.allPosts}
              <IconArrowRight class="inline-block rtl:-rotate-180" />
            </LinkButton>
          </div>
        </section>
      )
    }

    {
      sortedPosts.length === 0 && (
        <section class="pt-12 pb-6">
          <p class="text-muted-foreground">No posts yet.</p>
        </section>
      )
    }

    <section id="about" class="border-border mt-6 border-t py-10">
      <h2 class="text-2xl font-semibold tracking-wide">About</h2>
      <p class="mt-4">I'm Chenghao.</p>
      <p class="mt-2 max-w-2xl leading-relaxed">
        这里主要记录软件工程、后端、Agent、分布式系统、项目复盘、面试经历，以及值得长期保存的工具和经验。
      </p>
      <LinkButton
        href={getRelativeLocaleUrl(locale, "about")}
        data-astro-prefetch="viewport"
        class="mt-4"
      >
        More about me
        <IconArrowRight class="inline-block rtl:-rotate-180" />
      </LinkButton>
    </section>
  </main>
  <Footer />
</Layout>

<script>
  document.addEventListener("astro:page-load", () => {
    const indexLayout = (document.querySelector("#main-content") as HTMLElement)
      ?.dataset;
    const baseRoot = import.meta.env.BASE_URL.replace(/\/?$/, "/");
    if (indexLayout?.layout) {
      sessionStorage.setItem("backUrl", indexLayout.homePath ?? baseRoot);
    }
  });
</script>

---
import { getCollection } from "astro:content";
import { getRelativeLocaleUrl } from "astro:i18n";
import IconArrowRight from "@/assets/icons/IconArrowRight.svg";
import Layout from "@/layouts/Layout.astro";
import Header from "@/components/Header.astro";
import Footer from "@/components/Footer.astro";
import Card from "@/components/Card.astro";
import LinkButton from "@/components/LinkButton.astro";
import { BROWSE_TAGS } from "@/utils/browseTags";
import { getSortedPosts } from "@/utils/getSortedPosts";
import { useTranslations } from "@/i18n";
import config from "@/config";

const { posts: postsConfig } = config;

const locale = Astro.currentLocale ?? config.site.lang;
const t = useTranslations(locale);

const posts = await getCollection("posts");
const sortedPosts = getSortedPosts(posts);
const homePath = getRelativeLocaleUrl(locale, "");
const rssPath = `${import.meta.env.BASE_URL.replace(/\/?$/, "/")}rss.xml`;
const githubUrl = "https://github.com/2021xs/liaochenghao.com";
const emailUrl = config.socials.find(
  ({ name, url }) => name === "mail" && url.startsWith("mailto:")
)?.url;
---

<Layout>
  <Header />
  <main
    id="main-content"
    data-layout="index"
    data-home-path={homePath}
    class="app-layout my-1"
  >
    <section
      id="status"
      aria-label="Current status"
      class="border-border bg-muted/30 mt-5 border-y px-3 py-2"
    >
      <p
        class="text-muted-foreground flex items-center gap-2 text-sm font-normal"
      >
        <span aria-hidden="true" class="bg-status size-2 shrink-0 rounded-full"
        ></span>
        <span>SEU · Hangzhou · ByteDance ing</span>
      </p>
    </section>

    <section id="intro" class="border-border border-b py-7 sm:py-9">
      <h1 class="text-lg leading-snug font-medium">
        Backend · Agent · Distributed Systems
      </h1>
      <div
        class="text-muted-foreground mt-4 flex flex-wrap items-center gap-2 text-sm font-normal"
      >
        <a
          href={githubUrl}
          target="_blank"
          rel="noopener noreferrer"
          class="hover:text-accent decoration-dashed underline-offset-4 hover:underline"
        >
          GitHub
        </a>
        <span aria-hidden="true">·</span>
        {
          emailUrl ? (
            <a
              href={emailUrl}
              class="hover:text-accent decoration-dashed underline-offset-4 hover:underline"
            >
              Email
            </a>
          ) : (
            <span
              aria-label="Email address not configured"
              aria-disabled="true"
              title="Email address not configured"
              class="cursor-default opacity-60"
            >
              Email
            </span>
          )
        }
        <span aria-hidden="true">·</span>
        <a
          href={rssPath}
          class="hover:text-accent decoration-dashed underline-offset-4 hover:underline"
        >
          RSS
        </a>
      </div>
    </section>

    {
      sortedPosts.length > 0 && (
        <section id="latest" class="border-border border-b py-10">
          <h2 class="text-xl font-semibold">Latest Writing</h2>
          <ul>
            {sortedPosts.slice(0, postsConfig.perIndex).map(data => (
              <Card variant="h3" showPrimaryType {...data} />
            ))}
          </ul>
          <div class="mt-7">
            <LinkButton
              href={getRelativeLocaleUrl(locale, "posts")}
              data-astro-prefetch="viewport"
              class="text-muted-foreground text-sm font-medium"
            >
              {t.home.allPosts}
              <IconArrowRight class="inline-block rtl:-rotate-180" />
            </LinkButton>
          </div>
        </section>
      )
    }

    {
      sortedPosts.length === 0 && (
        <section class="border-border border-b py-10">
          <h2 class="text-xl font-semibold">Latest Writing</h2>
          <p class="text-muted-foreground">No posts yet.</p>
        </section>
      )
    }

    <section id="browse" class="py-8 sm:py-9">
      <h2 class="text-xl font-semibold">Browse</h2>
      <ul class="mt-4 grid gap-x-8 gap-y-2 sm:grid-cols-2">
        {
          BROWSE_TAGS.map(({ label, tag }) => (
            <li>
              <a
                href={getRelativeLocaleUrl(locale, `tags/${tag}`)}
                data-astro-prefetch="viewport"
                class="text-muted-foreground hover:text-accent focus-visible:text-accent inline-flex py-1 text-sm font-medium decoration-dashed underline-offset-4 hover:underline focus-visible:underline"
              >
                {label}
              </a>
            </li>
          ))
        }
      </ul>
    </section>
  </main>
  <Footer />
</Layout>

<script>
  document.addEventListener("astro:page-load", () => {
    const indexLayout = (document.querySelector("#main-content") as HTMLElement)
      ?.dataset;
    const baseRoot = import.meta.env.BASE_URL.replace(/\/?$/, "/");
    if (indexLayout?.layout) {
      sessionStorage.setItem("backUrl", indexLayout.homePath ?? baseRoot);
    }
  });
</script>
